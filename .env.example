# ==============================================================================
# Database Configuration (MySQL)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=pothole_detection_db

# ==============================================================================
# Flask REST API Server Configuration
# ==============================================================================
FLASK_ENV=development
FLASK_APP=app.api.routes
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# ==============================================================================
# Streamlit Dashboard Configuration
# ==============================================================================
STREAMLIT_SERVER_PORT=8501
API_BASE_URL=http://127.0.0.1:5000/api/v1

# ==============================================================================
# Model & Computer Vision Settings
# ==============================================================================
# Path to YOLOv8 weights file (e.g. models/pothole_yolov8n.pt or yolov8n.pt for baseline)
MODEL_PATH=models/pothole_yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=cpu
# FRAME_SKIP: Process 1 frame every N frames (1 = process every frame, 3 = process 1 frame every 3 frames)
FRAME_SKIP=2
# TARGET_INFERENCE_SIZE: Resized square dimension for YOLO inference
TARGET_INFERENCE_SIZE=640

# ==============================================================================
# Severity Thresholds (Bounding box area relative to frame area)
# Area Ratio = (bbox_width * bbox_height) / (frame_width * frame_height)
# ==============================================================================
SEVERITY_LOW_MAX_AREA=0.015
SEVERITY_MED_MAX_AREA=0.045

# ==============================================================================
# Directory Storage Paths
# ==============================================================================
UPLOAD_FOLDER=data/raw
PROCESSED_FOLDER=data/processed
OUTPUT_VIDEO_FOLDER=outputs/videos
OUTPUT_IMAGE_FOLDER=outputs/images
OUTPUT_REPORT_FOLDER=outputs/reports
LOG_DIR=logs
LOG_LEVEL=INFO

# ==============================================================================
# Upload Restrictions
# ==============================================================================
MAX_CONTENT_LENGTH_MB=200
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv
